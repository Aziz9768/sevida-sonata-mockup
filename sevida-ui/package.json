{
  "name": "sevida-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Sevida UI: the common React component library (with Storybook showcase) shared by Sevida Lite and Leap Metrics apps.",
  "type": "module",
  "main": "./dist/sevida-ui.js",
  "module": "./dist/sevida-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/sevida-ui.js"
    },
    "./fonts.css": "./fonts.css"
  },
  "files": [
    "dist",
    "fonts.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.3"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
